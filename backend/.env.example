# Copy to backend/.env and fill in. Never commit the real file.
# Set one AI key. GEMINI_API_KEY (Google AI Studio, free tier) is used when present.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=google/gemini-2.5-flash
PORT=4000
CORS_ORIGIN=http://localhost:5173
